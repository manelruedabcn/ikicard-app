NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secreto que autentica los cron (cabecera x-cron-secret).
CRON_SECRET=your-cron-secret
# Secreto del webhook de alta de usuario (cabecera x-webhook-secret).
WEBHOOK_SECRET=your-webhook-secret
# Clave propia para firmar enlaces de baja. Si se deja vacía, se usa CRON_SECRET.
# Definirla separa la firma de bajas de la autenticación de los cron.
UNSUB_SECRET=your-unsubscribe-secret
# Avisos a Telegram (registros nuevos y estado horario).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
